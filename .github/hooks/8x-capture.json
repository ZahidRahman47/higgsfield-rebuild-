{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "node .github/hooks/capture.cjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "node .github/hooks/capture.cjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}